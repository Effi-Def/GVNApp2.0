# Firebase Configuration Example
# Copia questo file in .env.local e sostituisci con i tuoi valori reali da Firebase Console

# 1. Vai su Firebase Console: https://console.firebase.google.com
# 2. Seleziona il tuo progetto
# 3. Vai su Project Settings (⚙️) > General tab
# 4. Scorri fino a "Your apps" e clicca su "Config" 
# 5. Copia i valori nella configurazione JavaScript

VITE_FIREBASE_API_KEY=your_actual_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com  
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Opzionale - Solo se usi Cloud Messaging per notifiche push
# Vai su Project Settings > Cloud Messaging tab
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

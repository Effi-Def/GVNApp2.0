{
  "name": "gvnapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:icons": "node scripts/generate-icons.mjs",
    "lint": "eslint . --ext ts,tsx",
    "preview": "vite preview",
    "firebase:login": "npx firebase-tools login",
    "firebase:use": "npx firebase-tools use",
    "deploy": "npm run build && npx firebase-tools deploy",
    "deploy:functions": "cd functions && npm run build && npx firebase-tools deploy --only functions"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "firebase": "^10.7.1",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.66.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.20.1",
    "zod": "^4.1.13",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "sharp": "^0.33.4",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.17.4"
  }
}

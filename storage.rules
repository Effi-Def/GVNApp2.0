rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Avatars: users can write only their own, reads configurable
    match /avatars/{uid}/{allPaths=**} {
      // Change to `request.auth != null` if you want only signed-in users to read
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Event Chat Attachments
    // Read/write only for the event creator or explicit participants.
    // Legacy events without participantIds remain accessible to any signed-in user.
    match /events/{eventId}/chat/{messageId}/{fileName} {
      function eventDoc() {
        return firestore.get(/databases/(default)/documents/events/$(eventId)).data;
      }
      function canAccessEventChat() {
        let ev = eventDoc();
        return ev.createdBy == request.auth.uid
          || !('participantIds' in ev)
          || request.auth.uid in ev.participantIds;
      }
      allow read: if request.auth != null && canAccessEventChat();
      allow write: if request.auth != null && canAccessEventChat();
    }
  }
}

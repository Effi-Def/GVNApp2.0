rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Avatars: users can write only their own, reads configurable
    match /avatars/{uid}/{allPaths=**} {
      // Change to `request.auth != null` if you want only signed-in users to read
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Event Chat Attachments
    // Read: any authenticated user (attachments may be shared with viewers)
    // Write: only participants of the event (checked via Firestore get)
    match /events/{eventId}/chat/{messageId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid in firestore.get(
          /databases/(default)/documents/events/$(eventId)
        ).data.participantIds;
    }
  }
}

@tailwind base;
@tailwind components;
@tailwind utilities;

/* Design System Variables */
:root {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  line-height: 1.6;
  font-weight: 400;
  
  /* Colori del design system */
  --color-primary: #007bff;
  --color-accent: #ec4899;
  --color-neutral-50: #fafafa;
  --color-neutral-900: #171717;

  color-scheme: light;
  color: var(--color-neutral-900);
  background-color: var(--color-neutral-50);

  /* Typography ottimizzata */
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  -webkit-text-size-adjust: 100%;
}

/* Reset moderno */
*, *::before, *::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: linear-gradient(135deg, #fafafa 0%, #f5f5f5 100%);
}

/* Componenti personalizzati per GVNApp */
@layer components {
  /* Card moderna con shadow morbida */
  .gvn-card {
    @apply bg-white rounded-2xl shadow-lg shadow-neutral-200/50 border border-neutral-100 transition-all duration-200 hover:shadow-xl hover:shadow-neutral-200/60;
  }
  
  /* Button primario con il nuovo stile */
  .gvn-btn-primary {
    @apply bg-gradient-to-r from-primary-500 to-primary-600 text-white font-semibold px-6 py-3 rounded-xl shadow-lg shadow-primary-500/25 transition-all duration-200 hover:shadow-xl hover:shadow-primary-500/30 hover:scale-105 active:scale-95;
  }
  
  /* Button secondario */
  .gvn-btn-secondary {
    @apply bg-neutral-50 text-neutral-700 font-medium px-6 py-3 rounded-xl border border-neutral-200 transition-all duration-200 hover:bg-white hover:shadow-md hover:border-neutral-300;
  }
  
  /* Input moderno */
  .gvn-input {
    @apply w-full px-4 py-3 rounded-xl border-2 border-neutral-200 bg-white text-neutral-900 placeholder-neutral-400 font-medium transition-all duration-200 focus:outline-none focus:border-primary-500 focus:ring-4 focus:ring-primary-500/10;
  }
  
  /* Titoli con font display */
  .gvn-title {
    @apply font-display font-bold text-neutral-900 tracking-tight;
  }
  
  /* Badge con mascotte */
  .gvn-badge-pig {
    @apply inline-flex items-center space-x-1 bg-accent-50 text-accent-700 px-3 py-1 rounded-full text-sm font-medium border border-accent-200;
  }
}

/* Animazioni personalizzate */
@layer utilities {
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
  
  .safe-area-inset-bottom {
    padding-bottom: env(safe-area-inset-bottom);
  }
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

#root {
  width: 100%;
  margin: 0 auto;
  text-align: center;
}

import { useEffect, useState } from 'react'
import { useAppStore } from '../stores/AppStore'
import { useAuthStore } from '../stores/useAuthStore'
import { eventService } from '../services/firestore'

const HomePage = () => {
  const { user } = useAuthStore()
  const { events, expenses, setEvents } = useAppStore()
  const [loadingEvents, setLoadingEvents] = useState(false)

  // Carica gli eventi se non sono già presenti e c'è un utente
  useEffect(() => {
    const loadEvents = async () => {
      if (user && events.length === 0 && !loadingEvents) {
        setLoadingEvents(true)
        try {
          const eventsData = await eventService.getAll()
          setEvents(eventsData)
        } catch (error) {
          console.error('Error loading events:', error)
        } finally {
          setLoadingEvents(false)
        }
      }
    }
    
    loadEvents()
  }, [user, events.length, setEvents, loadingEvents])

  // Prendi i prossimi 3-5 eventi
  const today = new Date()
  today.setHours(0, 0, 0, 0) // Imposta a mezzanotte per confronto più accurato
  
  const upcomingEvents = events
    .filter(event => {
      const eventDate = new Date(event.date)
      eventDate.setHours(0, 0, 0, 0) // Imposta a mezzanotte per confronto
      return eventDate >= today
    })
    .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
  
  const nextUpcomingEvents = upcomingEvents.slice(0, 5)

  // Calcola il bilancio delle spese per l'utente corrente
  const userBalance = expenses.reduce((balance, expense) => {
    const userParticipation = expense.participants.find(p => p.userId === user?.id)
    if (!userParticipation) return balance

    if (expense.paidBy === user?.id) {
      // L'utente ha pagato, deve ricevere dagli altri
      const totalOwed = expense.participants
        .filter(p => p.userId !== user?.id)
        .reduce((sum, p) => sum + p.amount, 0)
      return balance + totalOwed
    } else {
      // L'utente deve pagare
      return balance - userParticipation.amount
    }
  }, 0)

  return (
    <div className="space-y-6">
      {/* Header di benvenuto */}
      <div className="bg-white rounded-lg shadow p-6">
        <h1 className="text-2xl font-bold text-gray-900 mb-2">
          Ciao, {user?.displayName}! 👋
        </h1>
        <p className="text-gray-600">
          Ecco un riepilogo delle tue attività di gruppo
        </p>
      </div>

      {/* Riepilogo finanziario */}
      <div className="bg-white rounded-lg shadow p-6">
        <h2 className="text-lg font-semibold text-gray-900 mb-4">💰 Situazione Spese</h2>
        <div className="flex items-center justify-between">
          <span className="text-gray-600">Bilancio totale:</span>
          <span className={`text-xl font-bold ${
            userBalance > 0 ? 'text-green-600' : userBalance < 0 ? 'text-red-600' : 'text-gray-600'
          }`}>
            {userBalance > 0 ? '+' : ''}{userBalance.toFixed(2)}€
          </span>
        </div>
        <p className="text-sm text-gray-500 mt-2">
          {userBalance > 0 
            ? 'Devi ricevere denaro dal gruppo' 
            : userBalance < 0 
            ? 'Devi pagare al gruppo' 
            : 'Sei in pari con tutti'
          }
        </p>
      </div>

      {/* Prossimi eventi */}
      <div className="bg-white rounded-lg shadow p-6">
        <h2 className="text-lg font-semibold text-gray-900 mb-4">� Prossimi Eventi</h2>
        
        {loadingEvents ? (
          <div className="flex items-center justify-center py-8">
            <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-600"></div>
          </div>
        ) : nextUpcomingEvents.length > 0 ? (
          <div className="space-y-3">
            {nextUpcomingEvents.map((event) => (
              <div key={event.id} className="border-l-4 border-primary-500 pl-4 py-2">
                <h3 className="font-medium text-gray-900">{event.title}</h3>
                <p className="text-sm text-gray-600">
                  {new Date(event.date).toLocaleDateString('it-IT')} alle {event.time}
                </p>
                <p className="text-sm text-gray-500">{event.location}</p>
                <p className="text-xs text-primary-600 mt-1">
                  {event.participants.filter(p => p.status === 'yes').length} confermati
                </p>
              </div>
            ))}
          </div>
        ) : (
          <p className="text-gray-500 text-center py-4">
            Nessun evento in programma. Creane uno nuovo!
          </p>
        )}
      </div>

      {/* Attività recenti */}
      <div className="bg-white rounded-lg shadow p-6">
        <h2 className="text-lg font-semibold text-gray-900 mb-4">🔔 Attività Recenti</h2>
        <div className="space-y-3">
          <div className="flex items-center space-x-3 text-sm">
            <div className="w-2 h-2 bg-blue-500 rounded-full"></div>
            <span className="text-gray-600">Nuovo evento creato: "Cena al ristorante"</span>
            <span className="text-gray-400">2 ore fa</span>
          </div>
          <div className="flex items-center space-x-3 text-sm">
            <div className="w-2 h-2 bg-green-500 rounded-full"></div>
            <span className="text-gray-600">Marco ha confermato la partecipazione all'evento</span>
            <span className="text-gray-400">5 ore fa</span>
          </div>
          <div className="flex items-center space-x-3 text-sm">
            <div className="w-2 h-2 bg-yellow-500 rounded-full"></div>
            <span className="text-gray-600">Nuova spesa aggiunta: "Benzina viaggio"</span>
            <span className="text-gray-400">1 giorno fa</span>
          </div>
        </div>
      </div>
    </div>
  )
}

export default HomePage

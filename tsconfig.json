{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/App-firebase.tsx",
    "src/App-test.tsx",
    "src/pages/HomePage-tailwind.tsx",
    "src/pages/HomePage-temp.tsx",
    "src/pages/ExpensesPage-firebase.tsx",
    "src/pages/ListsPage-firebase.tsx",
    "src/components/EventDashboard.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
